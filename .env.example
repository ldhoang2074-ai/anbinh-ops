# ============================================================
#  AN BÌNH OPS — Admin (Next.js) environment
#  Sao chép file này thành .env.local (KHÔNG commit .env.local)
# ============================================================

# --- Client-side (được nhúng vào browser bundle — CHỈ đặt giá trị public) ---
# URL project Supabase, ví dụ https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (an toàn để lộ ở client — RLS bảo vệ dữ liệu)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL công khai của app admin (dùng cho OAuth redirect), ví dụ https://admin.anbinh.vn
# Cần prefix NEXT_PUBLIC_ vì trang login (client) đọc biến này.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (TUYỆT ĐỐI không để lộ ra client, không commit) ---
# Service role key — chỉ dùng trong Route Handler/Edge Function phía server
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# Google Client ID/Secret KHÔNG đặt ở đây nếu dùng Supabase-hosted Google provider:
# đặt trực tiếp trong Supabase Dashboard > Authentication > Providers > Google.
# Nếu tự xử lý OAuth phía server thì mới cần 2 biến dưới (server-only):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Tổ chức mặc định (seed) ---
NEXT_PUBLIC_DEFAULT_ORG_SLUG=an-binh
